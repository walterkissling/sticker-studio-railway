# Required: Gemini API key for image generation
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Email configuration for order notifications
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
BUSINESS_EMAIL=
EMAIL_FROM=Sticker Studio <orders@sticker-studio-v.com>

# Server port (Railway sets this automatically)
PORT=3000

# AI designs per email and per IP per day. 0 = unlimited
DAILY_LIMIT=20

# PayPal Checkout. Sandbox first. Live needs PAYPAL_MODE=live
# App credentials: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
SHEET_PRICE_USD=10.00
